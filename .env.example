# 开发默认演示；正式构建始终使用真实 API。
# 开发联调时改为 api，生产不会读取 demo 值开启演示。
VITE_DATA_MODE=demo
VITE_API_BASE_URL=/api
VITE_SITE_NAME=政企园区企业服务平台
VITE_PARK_NAME=经开区
VITE_HERO_IMAGE=
VITE_SUPPORT_PHONE=
VITE_ICP_NUMBER=
# 本地跨域代理通过命令行提供：API_PROXY_TARGET=http://localhost:8080 npm run dev
# 子目录发布：DEPLOY_BASE=/client/ npm run build

# V2 首页运营内容，可改为后台公开 JSON 接口。留空读取 public/content/homepage.json
VITE_HOMEPAGE_CONTENT_URL=
# 正式首页支持 v1 / v2 / v3，默认 v2；验收环境可通过悬浮按钮切换
VITE_HOME_VERSION=v2
