{
  "name": "park-client",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/check-production.mjs",
    "build:preview": "npm run typecheck && vite build --mode preview --outDir dist-preview",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:demo": "vite preview --outDir dist-preview --host 127.0.0.1 --port 4174 --strictPort",
    "format": "prettier --write src docs README.md vite.config.ts",
    "format:check": "prettier --check src docs README.md vite.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.102.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
